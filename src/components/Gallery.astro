  { src: g37, alt: 'Dean Cascione with Rudy Sarzo', caption: 'Rudy Sarzo', cat: 'players', feature: true },
  { src: g38, alt: 'Dean Cascione with Adrian Vandenberg', caption: 'Adrian Vandenberg', cat: 'players' },
  { src: g39, alt: 'Dean Cascione — California shoot', caption: 'California', sub: 'Photo shoot', cat: 'stage' },
  { src: g40, alt: 'Dean Cascione with Brad Gillis and Floyd Rose', caption: 'Brad Gillis & Floyd Rose', cat: 'players' },
  { src: g41, alt: 'Dean Cascione with Joe Stump', caption: 'Joe Stump', cat: 'players' },
  { src: g42, alt: 'Dean Cascione with Kelly Simonz', caption: 'Kelly Simonz', cat: 'players' },
  { src: g43, alt: 'Dean Cascione with Floyd Rose', caption: 'Floyd Rose', cat: 'gear' },
  { src: g44, alt: 'Dean Cascione with Andy Timmons', caption: 'Andy Timmons', cat: 'players', feature: true },
  { src: g45, alt: 'Dean Cascione and Maxx Carlisle — shred guitar', caption: 'Maxx Carlisle', sub: 'Shred guitar', cat: 'players' },
  { src: g46, alt: 'Dean Cascione with Graphtech', caption: 'Graphtech', cat: 'gear' },
  { src: g47, alt: 'Dean Cascione — Bones Guitar', caption: 'Bones Guitar', cat: 'gear' },
  { src: g48, alt: 'Dean Cascione with Lizard Spit', caption: 'Lizard Spit', cat: 'gear' },
  { src: g49, alt: 'Dean Cascione at Spider Gates', caption: 'Spider Gates', cat: 'stage' },
  { src: g50, alt: 'Seymour Duncan Evolin with Dean Cascione', caption: 'Seymour Duncan', sub: 'Evolin', cat: 'gear' },
  { src: g51, alt: 'Dean Cascione with SIT Strings', caption: 'SIT Strings', cat: 'gear' },
  { src: g52, alt: 'Stone Tone Rock Block with Dean Cascione', caption: 'Stone Tone', sub: 'Rock Block', cat: 'gear' },
  { src: g53, alt: 'Dean Cascione at the Oxford Crypt', caption: 'Oxford Crypt', cat: 'stage' },
  { src: g54, alt: 'Dean Cascione playing double guitar', caption: 'Double guitar', cat: 'stage' },
  { src: g55, alt: 'Dean Cascione — Evolin Floyd Rose', caption: 'Evolin Floyd Rose', cat: 'gear' },
  { src: g56, alt: 'Dean Cascione and Maxx', caption: 'Maxx Carlisle', cat: 'players' },
  { src: g57, alt: 'Dean Cascione with Tony Rombola', caption: 'Tony Rombola', cat: 'players' },
  { src: g58, alt: 'Dean Cascione — 2026 Metal Warrior', caption: 'Metal Warrior', sub: '2026', cat: 'stage' },
];

// Wall order: lead with the big names, then mix in stage and gear so the
// first screen has variety. Indices not listed follow in their natural order.
const lead = [4, 0, 53, 17, 2, 11, 57, 27, 16, 19, 43, 9, 52, 3, 24, 26, 36, 37, 39, 30];
const order = [...lead, ...galleryPhotos.map((_, i) => i).filter((i) => !lead.includes(i))];

const LABELS: Record<Category, string> = { players: 'Players', gear: 'Gear & Builders', stage: 'On Stage' };
const counts = galleryPhotos.reduce<Record<Category, number>>(
  (acc, p) => ((acc[p.cat] += 1), acc),
  { players: 0, gear: 0, stage: 0 },
);

// Full-size view: never upscale (originals are 360–600px wide), so the
// lightbox shows each photo at its true size over a blurred copy of itself.
const photos = await Promise.all(
  order.map(async (n) => {
    const photo = galleryPhotos[n];
    const full = await getImage({ src: photo.src, width: photo.src.width, format: 'webp', quality: 82 });
    const ratio = photo.src.height / photo.src.width;
    const shape = photo.feature ? 'feature' : ratio > 1.3 ? 'tall' : ratio < 0.62 ? 'wide' : 'std';
    return { ...photo, n, fullSrc: full.src, shape };
  }),
);

const INITIAL = 17;
---

<section class="section" id="gallery">
  <div class="container">
    <div class="section-head">
      <span class="section-eyebrow">Gallery</span>
      <h2 class="section-title">Wall of Fame</h2>
      <p class="section-subtitle">
        On stage and off — with the guitarists, builders, and brands that shape
        the shred community. Tap any photo to see it up close.
      </p>
    </div>

    <div class="wall-filters" role="toolbar" aria-label="Filter photos">
      <button type="button" class="wall-filter is-active" data-filter="all" aria-pressed="true">
        All <span>{galleryPhotos.length}</span>
      </button>
      {(Object.keys(LABELS) as Category[]).map((c) => (
        <button type="button" class="wall-filter" data-filter={c} aria-pressed="false">
          {LABELS[c]} <span>{counts[c]}</span>
        </button>
      ))}
    </div>

    <ul class="wall" id="wall" data-limit={INITIAL}>
      {photos.map((p, i) => (
        <li class={`wall__tile wall__tile--${p.shape}`} data-cat={p.cat} data-n={p.n} hidden={i >= INITIAL ? true : undefined}>
          <button
            type="button"
            class="wall__btn"
            data-full={p.fullSrc}
            data-caption={p.caption}
            data-sub={p.sub ?? LABELS[p.cat]}
            data-w={p.src.width}
            data-h={p.src.height}
            aria-label={`View photo: ${p.alt}`}
          >
            <Image
              class="wall__img"
              src={p.src}
              alt={p.alt}
              widths={[p.src.width]}
              sizes={p.shape === 'feature' ? '(max-width: 640px) 100vw, 400px' : '(max-width: 640px) 50vw, 220px'}
              loading={i < 8 ? 'eager' : 'lazy'}
            />
            <span class="wall__grade" aria-hidden="true"></span>
            <span class="wall__cap" aria-hidden="true">
              <span class="wall__sub">{p.sub ?? LABELS[p.cat]}</span>
              <span class="wall__name">{p.caption}</span>
            </span>
          </button>
        </li>
      ))}
    </ul>

    <div class="wall-more">
      <button type="button" class="btn btn--ghost btn--lg" id="wallMore">
        Show all <span id="wallMoreCount">{galleryPhotos.length}</span> photos
      </button>
    </div>
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <div class="lightbox__backdrop" id="lightboxBackdrop" aria-hidden="true"></div>
    <button class="lightbox__close" id="lightboxClose" type="button" aria-label="Close photo viewer">&times;</button>
    <button class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" type="button" aria-label="Previous photo">&#8249;</button>
    <figure class="lightbox__figure">
      <img class="lightbox__img" id="lightboxImg" src="" alt="" />
      <figcaption class="lightbox__caption">
        <span class="lightbox__sub" id="lightboxSub"></span>
        <span class="lightbox__name" id="lightboxName"></span>
        <span class="lightbox__count" id="lightboxCount"></span>
      </figcaption>
    </figure>
    <button class="lightbox__nav lightbox__nav--next" id="lightboxNext" type="button" aria-label="Next photo">&#8250;</button>
    <div class="lightbox__strip" id="lightboxStrip" aria-hidden="true"></div>
  </div>
</section>

<script>
  const wall = document.getElementById('wall');
  const tiles = Array.from(document.querySelectorAll<HTMLLIElement>('.wall__tile'));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.wall-filter'));
  const moreBtn = document.getElementById('wallMore') as HTMLButtonElement | null;
  const moreCount = document.getElementById('wallMoreCount');
  const LIMIT = Number(wall?.dataset.limit ?? 17);

  let filter = 'all';
  let expanded = false;

  const inFilter = (t: HTMLElement) => filter === 'all' || t.dataset.cat === filter;

  function renderWall() {
    const matching = tiles.filter(inFilter);
    tiles.forEach((t) => (t.hidden = true));
    matching.forEach((t, i) => (t.hidden = !expanded && i >= LIMIT));
    const rest = matching.length - LIMIT;
    if (moreBtn) moreBtn.parentElement!.hidden = expanded || rest <= 0;
    if (moreCount) moreCount.textContent = String(matching.length);
    // Stagger the newly shown tiles in.
    matching.forEach((t, i) => {
      t.style.setProperty('--d', `${Math.min(i, 16) * 35}ms`);
      t.classList.remove('is-in');
      void t.offsetWidth;
      t.classList.add('is-in');
    });
  }

  filters.forEach((b) =>
    b.addEventListener('click', () => {
      filter = b.dataset.filter ?? 'all';
      expanded = false;
      filters.forEach((f) => {
        const on = f === b;
        f.classList.toggle('is-active', on);
        f.setAttribute('aria-pressed', String(on));
      });
      renderWall();
    }),
  );
  moreBtn?.addEventListener('click', () => {
    expanded = true;
    renderWall();
  });

  // Touch screens have no hover: light up (full color) whichever tiles sit in
  // the middle band of the screen as you scroll.
  if (matchMedia('(hover: none)').matches && 'IntersectionObserver' in window) {
    const lit = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('is-lit', e.isIntersecting)),
      { rootMargin: '-35% 0px -35% 0px' },
    );
    tiles.forEach((t) => lit.observe(t));
  }

  // ---------- Lightbox ----------
  const box = document.getElementById('lightbox');
  const img = document.getElementById('lightboxImg') as HTMLImageElement | null;
  const backdrop = document.getElementById('lightboxBackdrop');
  const nameEl = document.getElementById('lightboxName');
  const subEl = document.getElementById('lightboxSub');
  const countEl = document.getElementById('lightboxCount');
  const strip = document.getElementById('lightboxStrip');
  let set: HTMLLIElement[] = [];
  let current = 0;
  let lastFocus: HTMLElement | null = null;

  // Fit the photo to the room, but never past 1.6× its native size —
  // crisp enough to feel big, never stretched into mush.
  function size(w: number, h: number) {
    if (!img || !w || !h) return;
    const figure = img.parentElement!;
    const room = box!.getBoundingClientRect();
    const isPhone = innerWidth <= 640;
    const availW = room.width - (isPhone ? 24 : 160);
    const availH = room.height - (isPhone ? 250 : 285); // nav row, caption, filmstrip
    const k = Math.min(1.6, availW / w, availH / h);
    img.style.width = `${Math.round(w * k)}px`;
    img.style.height = `${Math.round(h * k)}px`;
    figure.style.maxWidth = `${Math.round(Math.max(w * k, 280))}px`;
  }
  addEventListener('resize', () => {
    const btn = set[current]?.querySelector<HTMLButtonElement>('.wall__btn');
    if (box?.classList.contains('is-open') && btn) size(Number(btn.dataset.w), Number(btn.dataset.h));
  });

  function render() {
    const tile = set[current];
    const btn = tile?.querySelector<HTMLButtonElement>('.wall__btn');
    if (!btn || !img) return;
    const w = Number(btn.dataset.w);
    const h = Number(btn.dataset.h);
    img.src = btn.dataset.full ?? '';
    img.alt = tile.querySelector('img')?.alt ?? '';
    size(w, h);
    backdrop?.style.setProperty('background-image', `url("${btn.dataset.full}")`);
    if (nameEl) nameEl.textContent = btn.dataset.caption ?? '';
    if (subEl) subEl.textContent = btn.dataset.sub ?? '';
    if (countEl) countEl.textContent = `${current + 1} / ${set.length}`;
    strip?.querySelectorAll('img').forEach((t, i) => t.classList.toggle('is-active', i === current));
    strip?.children[current]?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
  }

  function buildStrip() {
    if (!strip) return;
    strip.innerHTML = '';
    set.forEach((tile, i) => {
      const src = tile.querySelector('img')?.currentSrc || tile.querySelector('img')?.src || '';
      const t = document.createElement('img');
      t.src = src;
      t.alt = '';
      t.loading = 'lazy';
      t.addEventListener('click', () => {
        current = i;
        render();
      });
      strip.appendChild(t);
    });
  }

  function open(tile: HTMLLIElement) {
    set = tiles.filter(inFilter);
    if (!set.includes(tile)) {
      // Opened from elsewhere (Legends marquee) under another filter.
      filters[0]?.click();
      set = tiles.slice();
    }
    current = set.indexOf(tile);
    lastFocus = document.activeElement as HTMLElement | null;
    buildStrip();
    box?.removeAttribute('hidden');
    requestAnimationFrame(() => box?.classList.add('is-open'));
    document.body.style.overflow = 'hidden';
    render();
    document.getElementById('lightboxClose')?.focus({ preventScroll: true });
  }

  function close() {
    box?.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(() => box?.setAttribute('hidden', ''), 250);
    lastFocus?.focus({ preventScroll: true });
  }

  const step = (d: number) => {
    current = (current + d + set.length) % set.length;
    render();
  };

  tiles.forEach((t) => t.querySelector('.wall__btn')?.addEventListener('click', () => open(t)));
  document.getElementById('lightboxClose')?.addEventListener('click', close);
  document.getElementById('lightboxPrev')?.addEventListener('click', () => step(-1));
  document.getElementById('lightboxNext')?.addEventListener('click', () => step(1));
  backdrop?.addEventListener('click', close);

  document.addEventListener('keydown', (e) => {
    if (!box?.classList.contains('is-open')) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') step(1);
    else if (e.key === 'ArrowLeft') step(-1);
  });

  // Swipe left/right on touch.
  let x0: number | null = null;
  box?.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  box?.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 45) step(dx < 0 ? 1 : -1);
    x0 = null;
  });

  // Other sections (the Legends marquee) open a photo by its data index.
  window.addEventListener('gallery:open', (e) => {
    const n = (e as CustomEvent<{ index: number }>).detail?.index;
    const tile = tiles.find((t) => Number(t.dataset.n) === n);
    if (tile) open(tile);
  });
</script>
