// Pre-generate an optimized full-size WebP for the lightbox so we don't serve
// the raw originals. 1600px wide, quality 78 — sharp enough full-screen.
const photos = await Promise.all(
  galleryPhotos.map(async (photo) => {
    const full = await getImage({
      src: photo.src,
      width: 1600,
      format: 'webp',
      quality: 78,
    });
    return { ...photo, fullSrc: full.src };
  }),
);
---

<section class="section" id="gallery">
  <div class="container">
    <div class="section-head">
      <span class="section-eyebrow">Gallery</span>
      <h2 class="section-title">In Good Company</h2>
      <p class="section-subtitle">
        On stage and off — with the guitarists, builders, and brands that shape
        the shred community. Tap any photo to enlarge.
      </p>
    </div>

    {/* Live counter + horizontal carousel. Arrows are pointer-driven (desktop/
        tablet); touch devices swipe instead, so the arrows hide below 541px. */}
    <div class="gallery__carousel">
      <button class="gallery__arrow gallery__arrow--prev" id="galleryCarouselPrev" aria-label="Scroll gallery left" type="button">&#8249;</button>
      <div class="gallery__viewport">
        <p class="gallery__counter" id="galleryCounter" aria-live="polite">1 / {photos.length}</p>
        <div class="gallery__grid" id="galleryGrid">
          {photos.map((photo, i) => (
            <button
              class="gallery__item"
              data-full={photo.fullSrc}
              data-index={i}
              aria-label={`View photo ${i + 1}: ${photo.alt}`}
            >
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[300, 400, 500, 640]}
                sizes="(max-width: 540px) 100vw, (max-width: 880px) 50vw, 33vw"
                loading={i < 6 ? 'eager' : 'lazy'}
              />
            </button>
          ))}
        </div>
      </div>
      <button class="gallery__arrow gallery__arrow--next" id="galleryCarouselNext" aria-label="Scroll gallery right" type="button">&#8250;</button>
    </div>


    <div class="gallery__lightbox" id="galleryLightbox" aria-hidden="true">
      <button class="gallery__close" id="galleryClose" aria-label="Close gallery">&times;</button>
      <button class="gallery__nav gallery__nav--prev" id="galleryPrev" aria-label="Previous photo">&#8249;</button>
      <img class="gallery__fullimg" id="galleryFullImg" src="" alt="" />
      <button class="gallery__nav gallery__nav--next" id="galleryNext" aria-label="Next photo">&#8250;</button>
    </div>
  </div>
</section>

<script>
  const items = document.querySelectorAll<HTMLButtonElement>('.gallery__item');
  const lightbox = document.getElementById('galleryLightbox');
  const fullImg = document.getElementById('galleryFullImg') as HTMLImageElement | null;
  const closeBtn = document.getElementById('galleryClose');
  const prevBtn = document.getElementById('galleryPrev');
  const nextBtn = document.getElementById('galleryNext');
  const grid = document.getElementById('galleryGrid');
  const counter = document.getElementById('galleryCounter');
  const carPrevBtn = document.getElementById('galleryCarouselPrev') as HTMLButtonElement | null;
  const carNextBtn = document.getElementById('galleryCarouselNext') as HTMLButtonElement | null;

  let currentIndex = 0;

  // How many photos are visible across the carousel at once (1 on mobile,
  // 2 tablet, 3 desktop). Derived live so it stays correct on resize.
  function perView(): number {
    if (!grid || items.length === 0) return 1;
    const itemWidth = items[0].getBoundingClientRect().width;
    if (itemWidth <= 0) return 1;
    const gap = parseFloat(getComputedStyle(grid).columnGap || '0') || 0;
    const count = Math.round((grid.clientWidth + gap) / (itemWidth + gap));
    return Math.min(Math.max(count, 1), items.length);
  }

  // Counter reflects the visible range ("1–3 / 58"), not just the first item,
  // because desktop/tablet show several photos per view. Also toggles the
  // arrow disabled state at the strip's edges.
  function updateCarousel() {
    if (!grid) return;
    const itemWidth = items[0]?.getBoundingClientRect().width ?? 0;
    const gap = parseFloat(getComputedStyle(grid).columnGap || '0') || 0;
    const step = itemWidth + gap;
    const visible = perView();
    if (step > 0 && counter) {
      const first = Math.round(grid.scrollLeft / step);
      const clampedFirst = Math.min(Math.max(first, 0), items.length - 1);
      const last = Math.min(clampedFirst + visible - 1, items.length - 1);
      counter.textContent = visible > 1 && last > clampedFirst
        ? `${clampedFirst + 1}–${last + 1} / ${items.length}`
        : `${clampedFirst + 1} / ${items.length}`;
    }
    // Disable arrows at the ends so the affordance reflects reality.
    const atStart = grid.scrollLeft <= 1;
    const atEnd = grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 1;
    carPrevBtn && (carPrevBtn.disabled = atStart);
    carNextBtn && (carNextBtn.disabled = atEnd);
  }

  // Scroll by one "page" of visible photos (not a single item), matching how
  // a user expects a multi-photo carousel to advance.
  function scrollByPage(dir: 1 | -1) {
    if (!grid) return;
    const itemWidth = items[0]?.getBoundingClientRect().width ?? 0;
    const gap = parseFloat(getComputedStyle(grid).columnGap || '0') || 0;
    const delta = (itemWidth + gap) * perView() * dir;
    grid.scrollBy({ left: delta, behavior: 'smooth' });
  }

  carPrevBtn?.addEventListener('click', () => scrollByPage(-1));
  carNextBtn?.addEventListener('click', () => scrollByPage(1));

  grid?.addEventListener('scroll', () => {
    window.requestAnimationFrame(updateCarousel);
  }, { passive: true });
  window.addEventListener('resize', () => {
    window.requestAnimationFrame(updateCarousel);
  }, { passive: true });
  updateCarousel();

  function showImage() {
    const item = items[currentIndex];
    if (!item || !fullImg) return;
    fullImg.src = item.dataset.full ?? '';
    fullImg.alt = item.getAttribute('aria-label') ?? '';
  }

  function open(index: number) {
    currentIndex = index;
    showImage();
    lightbox?.classList.add('is-open');
    lightbox?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox?.classList.remove('is-open');
    lightbox?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function next() {
    currentIndex = (currentIndex + 1) % items.length;
    showImage();
  }

  function prev() {
    currentIndex = (currentIndex - 1 + items.length) % items.length;
    showImage();
  }

  items.forEach((item, i) => {
    item.addEventListener('click', () => open(i));
  });

  closeBtn?.addEventListener('click', close);
  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    next();
  });
  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    prev();
  });

  // Click the backdrop (not a child) to close.
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) close();
  });

  // Keyboard: Esc closes, arrows navigate — only when lightbox is open.
  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('is-open')) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') next();
    else if (e.key === 'ArrowLeft') prev();
  });
</script>
