type Category = 'players' | 'gear' | 'stage';
type Photo = {
  src: ImageMetadata;
  alt: string;
  caption: string;
  sub?: string;
  cat: Category;
  feature?: boolean;
};

// Index order matters: the Legends marquee opens photos by their index here.
// `caption` is the name shown on the wall; `cat` drives the filter chips;
// `feature` gets a big 2×2 tile.
const galleryPhotos: Photo[] = [
  { src: g01, alt: 'Dean Cascione with Uli Jon Roth and Joe Stump', caption: 'Uli Jon Roth & Joe Stump', cat: 'players', feature: true },
  { src: g02, alt: 'Dean Cascione performing at Club Jewel', caption: 'Club Jewel', sub: 'Live', cat: 'stage' },
  { src: g03, alt: 'Dean Cascione with Floyd Rose', caption: 'Floyd Rose', cat: 'gear' },
  { src: g04, alt: 'Dean Cascione with Michael Angelo Batio', caption: 'Michael Angelo Batio', cat: 'players', feature: true },
  { src: g05, alt: 'Dean Cascione with Jason Becker', caption: 'Jason Becker', cat: 'players', feature: true },
  { src: g06, alt: 'Dean Cascione at Club Jewel', caption: 'Club Jewel', sub: 'Live', cat: 'stage' },
  { src: g07, alt: 'Dean Cascione with ZT Amplifiers', caption: 'ZT Amplifiers', cat: 'gear' },
  { src: g08, alt: 'Dean Cascione with Joe Stump', caption: 'Joe Stump', cat: 'players' },
  { src: g09, alt: 'Dean Cascione with Bell and Johannsen', caption: 'Bell & Johannsen', cat: 'players' },
  { src: g10, alt: 'Dean Cascione with Jimi Bell', caption: 'Jimi Bell', cat: 'players' },
  { src: g11, alt: 'Dean Cascione with Lizard Spit', caption: 'Lizard Spit', cat: 'gear' },
  { src: g12, alt: 'Dean Cascione with Chris Impellitteri', caption: 'Chris Impellitteri', cat: 'players' },
  { src: g13, alt: 'Dean Cascione at Club Jewel', caption: 'Club Jewel', sub: 'Live', cat: 'stage' },
  { src: g14, alt: 'Dean Cascione with Robert Stone Tone and Floyd Rose', caption: 'Stone Tone & Floyd Rose', cat: 'gear' },
  { src: g15, alt: 'Dean Cascione with Patrik Johannson', caption: 'Patrik Johannson', cat: 'players' },
  { src: g16, alt: 'Dean Cascione with Ghee Yeh', caption: 'Ghee Yeh', cat: 'players' },
  { src: g17, alt: 'Dean Cascione with Jeff Loomis', caption: 'Jeff Loomis', cat: 'players' },
  { src: g18, alt: 'Dean Cascione with George Lynch', caption: 'George Lynch', cat: 'players', feature: true },
  { src: g19, alt: 'Dean Cascione with Joe Stump', caption: 'Joe Stump', cat: 'players' },
  { src: g20, alt: 'Dean Cascione with Seymour Duncan', caption: 'Seymour Duncan', cat: 'gear' },
  { src: g21, alt: 'Dean Cascione with Floyd Rose', caption: 'Floyd Rose', cat: 'gear' },
  { src: g22, alt: 'Dean Cascione with Hoogie and SIT Strings', caption: 'Hoogie & SIT Strings', cat: 'gear' },
  { src: g23, alt: 'Dean Cascione with Matthew Mills', caption: 'Matthew Mills', cat: 'players' },
