---
// Wall of Fame — a dense mosaic gallery with a unified crimson grade that
// blooms to full color on hover (or as tiles cross mid-screen on touch),
// name captions, filter chips, and a lightbox that shows each photo at its
// true size over a blurred copy of itself, with a filmstrip and swipe.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import g01 from '~/assets/images/gallery/gallery_01.jpg';
