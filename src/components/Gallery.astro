  { src: g29, alt: 'Dean Cascione with Kelly Garni — Quiet Riot', caption: 'Kelly Garni', sub: 'Quiet Riot', cat: 'players' },
  { src: g30, alt: 'Dean Cascione with Jason Boston — Bassman', caption: 'Jason Boston', sub: 'Bassman', cat: 'players' },
  { src: g31, alt: 'Dean Cascione with Tony Rombola', caption: 'Tony Rombola', cat: 'players' },
  { src: g32, alt: 'Dean Cascione with OZ Guitars', caption: 'OZ Guitars', cat: 'gear' },
  { src: g33, alt: 'Dean Cascione with Graphtech', caption: 'Graphtech', cat: 'gear' },
  { src: g34, alt: 'Dean Cascione — DOD and Digitech', caption: 'DOD & Digitech', cat: 'gear' },
