---
// Hero — full-bleed stone-church background, big display type, social + stats
import heroImg from '~/assets/images/hero-bg04.png';
import heroImgMobile from '~/assets/images/hero-bg05-mobile.png';
---

<section class="hero" id="top">
  <div class="hero__media">
    <img
      class="hero__img hero__img--mobile"
      src={heroImgMobile.src}
      srcset={heroImgMobile.srcset?.attribute}
      alt="Dean Cascione performing — neoclassical shred guitarist"
      loading="eager"
      sizes="100vw"
    />
    <img
      class="hero__img hero__img--desktop"
      src={heroImg.src}
      srcset={heroImg.srcset?.attribute}
      alt=""
      aria-hidden="true"
      loading="eager"
      sizes="100vw"
    />
  </div>

  <div class="container hero__inner">
    <span class="hero__eyebrow">Neoclassical Shred Guitarist · Hired Gun · USA</span>

    <h1 class="hero__title">
      Dean<br />
      <em>Cascione</em>
    </h1>

    <p class="hero__lead">
      American guitarist forging instrumental rock &amp; metal with melody,
      passion, and fretboard pyrotechnics. Chart-topping debut, MANOWAR's Dio
      tribute, and a decade on the NAMM stage.
    </p>

    <div class="hero__socials">
      <a
        class="hero__social"
        href="https://www.youtube.com/user/deancascione"
        target="_blank"
        rel="noopener"
        aria-label="Dean Cascione on YouTube"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z" />
        </svg>
      </a>
      <a
        class="hero__social"
        href="https://www.facebook.com/deancascione"
        target="_blank"
        rel="noopener"
        aria-label="Dean Cascione on Facebook"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7v-3.5h3.1V9.4c0-3 1.8-4.7 4.6-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9v2.2h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z" />
        </svg>
      </a>
      <a
        class="hero__social"
        href="https://www.instagram.com/deancascione"
        target="_blank"
        rel="noopener"
        aria-label="Dean Cascione on Instagram"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.2 0-3.5 0-4.8.1-.9 0-1.4.2-1.7.3-.4.2-.7.4-1 .7-.3.3-.5.6-.7 1-.1.3-.3.8-.3 1.7-.1 1.3-.1 1.6-.1 4.8s0 3.5.1 4.8c0 .9.2 1.4.3 1.7.2.4.4.7.7 1 .3.3.6.5 1 .7.3.1.8.3 1.7.3 1.3.1 1.6.1 4.8.1s3.5 0 4.8-.1c.9 0 1.4-.2 1.7-.3.4-.2.7-.4 1-.7.3-.3.5-.6.7-1 .1-.3.3-.8.3-1.7.1-1.3.1-1.6.1-4.8s0-3.5-.1-4.8c0-.9-.2-1.4-.3-1.7-.2-.4-.4-.7-.7-1-.3-.3-.6-.5-1-.7-.3-.1-.8-.3-1.7-.3-1.3-.1-1.6-.1-4.8-.1zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8zm0 8a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zm6.2-8.2a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0z" />
        </svg>
      </a>
    </div>

    <div class="hero__actions">
      <a href="#music" class="btn btn--primary btn--lg">Listen &amp; Watch</a>
      <a href="#contact" class="btn btn--ghost btn--lg">Bookings &amp; Lessons</a>
    </div>

    <div class="hero__stats">
      <div class="hero__stat">
        <span class="hero__stat-num">2+</span>
        <span class="hero__stat-label">Decades Performing</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-num">#1</span>
        <span class="hero__stat-label">Guitar9 Chart Debut</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-num">10+</span>
        <span class="hero__stat-label">Years at NAMM</span>
      </div>
    </div>
  </div>
</section>
