---
// Sticky glass nav · crimson "DC" mark · mobile toggle
const { active = 'home' } = Astro.props;
const links = [
  { id: 'home', label: 'Home', href: '#top' },
  { id: 'about', label: 'About', href: '#about' },
  { id: 'music', label: 'Music', href: '#music' },
  { id: 'endorsed', label: 'Endorsed', href: '#endorsed' },
  { id: 'shows', label: 'Shows', href: '#shows' },
  { id: 'gallery', label: 'Gallery', href: '#gallery' },
  { id: 'contact', label: 'Contact', href: '#contact' },
];
---

<header class="nav" id="nav">
  <div class="container nav__inner">
    <a href="#top" class="nav__brand" aria-label="Dean Cascione — home">
      <span class="nav__brand-mark">DC</span>
      <span>Dean Cascione</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav__list" id="navList">
        {links.map((link, i) => (
          <li style={`--i: ${i}`}>
            <a
              href={link.href}
              data-spy={link.href.slice(1)}
              class:list={['nav__link', { 'is-active': active === link.id }]}
            >
              <span class="nav__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {link.label}
            </a>
          </li>
        ))}
        <li class="nav__menu-cta" style={`--i: ${links.length}`}>
          <a href="#contact" class="btn btn--primary btn--lg" data-intent="bookings">Book Dean</a>
          <a href="mailto:dean@deancascione.com" class="nav__menu-mail">dean@deancascione.com</a>
        </li>
      </ul>
    </nav>

    <div class="nav__cta">
      <a
        href="https://www.youtube.com/user/deancascione"
        class="nav__social"
        target="_blank"
        rel="noopener"
        aria-label="Dean Cascione on YouTube"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z" />
        </svg>
        <span>Watch</span>
      </a>
      <a href="#contact" class="btn btn--primary" data-intent="bookings">Bookings</a>
      <button
        class="nav__toggle"
        id="navToggle"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <span class="nav__toggle-bar"></span>
        <span class="nav__toggle-bar"></span>
        <span class="nav__toggle-bar"></span>
      </button>
    </div>
  </div>
  <div class="nav__progress" id="navProgress" aria-hidden="true"></div>
</header>

<script>
  const nav = document.getElementById('nav');
  const toggle = document.getElementById('navToggle');
  const list = document.getElementById('navList');
  const progress = document.getElementById('navProgress');

  // Sticky state + reading-progress line, batched into one rAF per scroll.
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const max = document.documentElement.scrollHeight - innerHeight;
      nav?.classList.toggle('is-scrolled', scrollY > 24);
      progress?.style.setProperty('--p', String(max > 0 ? scrollY / max : 0));
      ticking = false;
    });
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Scrollspy: highlight the section currently under the reading line.
  const spyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav__link[data-spy]'));
  const byId = new Map(spyLinks.map((a) => [a.dataset.spy!, a]));
  // Sections without their own link light up their nearest parent entry.
  const alias: Record<string, string> = { 'free-book': 'music' };
  const setActive = (id: string) => {
    const target = byId.get(alias[id] ?? id);
    if (!target) return;
    spyLinks.forEach((a) => {
      const on = a === target;
      a.classList.toggle('is-active', on);
      if (on) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  };
  const spy = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('main section[id]').forEach((sec) => spy.observe(sec));

  // Mobile: full-screen menu overlay.
  const setOpen = (open: boolean) => {
    list?.classList.toggle('is-open', open);
    nav?.classList.toggle('is-menu-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  toggle?.addEventListener('click', () => setOpen(!list?.classList.contains('is-open')));
  list?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && list?.classList.contains('is-open')) setOpen(false);
  });
</script>
