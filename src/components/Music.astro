---
// Music — video jukebox (lite YouTube facades) + discography timeline
import { Image, getImage } from 'astro:assets';
import dioCover from '~/assets/images/dio-tribute.jpg';
import guitarChopShopCover from '~/assets/images/guitar-chop-shop.jpg';
import neoclassicalFireCover from '~/assets/images/neoclassical-fire.jpg';
import shredCrusadeCover from '~/assets/images/shred-crusade.jpg';
import betweenTwoAnvilsCover from '~/assets/images/between-two-anvils.jpg';
import liveAtSeneCover from '~/assets/images/live-at-sene.jpg';
import rhoadsRisingCover from '~/assets/images/rhoads-rising.jpg';
import guitarSymphonyCover from '~/assets/images/guitar-symphony.jpg';
import clashOfTheTitansCover from '~/assets/images/clash-of-the-titans.jpg';
import darkLordCover from '~/assets/images/dark-lord-rises.webp';
import ytDoppelgangers from '~/assets/images/yt-doppelgangers.jpg';
import ytMissionSpace from '~/assets/images/yt-mission-space.jpg';
import ytOdysseyDarkness from '~/assets/images/yt-odyssey-of-darkness.jpg';
import ytDoppelgangersHd from '~/assets/images/yt-doppelgangers-hd.jpg';
import ytMissionSpaceHd from '~/assets/images/yt-mission-space-hd.jpg';
import ytOdysseyDarknessHd from '~/assets/images/yt-odyssey-of-darkness-hd.jpg';

// Newest-first discography. `title` and `note` preserved verbatim from the
// legacy bio; `video` marks releases with an embedded YouTube link.
type Release = {
  year: string;
  title: string;
  note: string;
  cover?: ImageMetadata;
  url?: string;
};

// Video jukebox: one big stage + a tracklist. The stage shows an optimized
// poster (no YouTube JS/cookies until the visitor presses play), then swaps in
// a youtube-nocookie iframe with autoplay. Anything with data-play="<id>"
// elsewhere on the page (e.g. the hero) can start a track.
type Video = { id: string; title: string; label: string; year: string; poster: ImageMetadata; thumb: ImageMetadata };
const videos: Video[] = [
  { id: 'mkC3Xxem2Ns', title: 'Doppelgangers', label: 'New Single · feat. Maxxwell Carlisle', year: '2026', poster: ytDoppelgangersHd, thumb: ytDoppelgangers },
  { id: 'VEPlyiegWJQ', title: 'Mission Space', label: 'Original', year: '2024', poster: ytMissionSpaceHd, thumb: ytMissionSpace },
  { id: 'jHaTReC0d1w', title: 'Odyssey of Darkness', label: 'feat. Maxxwell Carlisle', year: '2024', poster: ytOdysseyDarknessHd, thumb: ytOdysseyDarkness },
];
const posters = await Promise.all(
  videos.map((v) => getImage({ src: v.poster, width: 1280, format: 'webp', quality: 78 })),
);

const releases: Release[] = [
  { year: '2026', title: 'Doppelgangers', note: 'Single — collaboration with Maxxwell Carlisle.', cover: ytDoppelgangers, url: 'https://youtu.be/mkC3Xxem2Ns' },
  { year: '2024', title: 'Mission Space', note: 'Single.', cover: ytMissionSpace, url: 'https://youtu.be/VEPlyiegWJQ' },
  { year: '2024', title: 'Odyssey of Darkness', note: 'Single — collaboration with Maxxwell Carlisle.', cover: ytOdysseyDarkness, url: 'https://youtu.be/jHaTReC0d1w' },
  { year: '2023', title: 'Between Two Anvils', note: 'Single — collaboration with Maxxwell Carlisle.', cover: betweenTwoAnvilsCover },
  { year: '2020', title: 'Rhoads Rising', note: 'Single — tribute to Randy Rhoads.', cover: rhoadsRisingCover },
  {
    year: '2018',
    title: 'Clash of the Titans',
    note: 'Single — featuring American guitar virtuosos Dean Cascione, Jimi Mitchell, Mike Kerr, and Matthew Mills.',
    cover: clashOfTheTitansCover,
  },
  {
    year: '2017',
    title: 'Guitar Symphony',
    note: 'Global collaboration with over 60 guitarists including George Bellas, Rusty Cooley, and Matt Mills.',
    cover: guitarSymphonyCover,
  },
  {
    year: '2016',
    title: 'Live at the SENE Film & Music Festival',
    note: 'Limited-edition live Blu-ray performance.',
    cover: liveAtSeneCover,
  },
  {
    year: '2016',
    title: 'The Dark Lord Rises / Brothers in Shred',
    note: 'Featured on Joe Stump\'s Lion Music release.',
    cover: darkLordCover,
    url: 'https://www.metal-archives.com/albums/Joe_Stump/The_Dark_Lord_Rises/540562',
  },
  {
    year: '2015',
    title: 'Shred Crusade',
    note: 'Album — neoclassic metal with guest guitarists David Shankle, Dave Mercado, and Joe Stump.',
    cover: shredCrusadeCover,
    url: 'https://www.metal-archives.com/albums/Dean_Cascione/Shred_Crusade/533283',
  },
  {
    year: '2011',
    title: 'Neoclassical Fire',
    note: 'Album — collaboration with keyboardist Mike Troy (Yngwie Malmsteen).',
    cover: neoclassicalFireCover,
    url: 'https://www.metal-archives.com/albums/Dean_Cascione/Neoclassical_Fire/319663',
  },
  {
    year: '2010',
    title: 'Magic: A Tribute to Ronnie James Dio',
    note: 'Album — worldwide release with MANOWAR, featuring instrumental cover of "Nevermore."',
    cover: dioCover,
    url: 'https://www.discogs.com/release/4063934-Various-Magic-A-Tribute-To-Ronnie-James-Dio',
  },
  {
    year: '2008',
    title: 'Guitar Chop Shop',
    note: 'Debut album — #1 in sales on Guitar9 charts.',
    cover: guitarChopShopCover,
    url: 'https://www.metal-archives.com/albums/Dean_Cascione/Guitar_Chop_Shop/201566',
  },
];

---

<section class="section section--elevated" id="music">
  <div class="container">
    <div class="section-head">
      <span class="section-eyebrow">Music</span>
      <h2 class="section-title">Discography &amp; Videos</h2>
      <p class="section-subtitle">
        Two decades of neoclassical shred — solo albums, global collaborations,
        and tribute work alongside the legends of metal.
      </p>
    </div>

    <div class="jukebox" id="jukebox">
      <div class="jukebox__stage" id="jukeboxStage">
        <Image
          class="jukebox__poster"
          id="jukeboxPoster"
          src={videos[0].poster}
          alt=""
          widths={[640, 960, 1280]}
          sizes="(max-width: 980px) 100vw, 860px"
          loading="lazy"
        />
        <div class="jukebox__shade" aria-hidden="true"></div>
        <button class="jukebox__play" id="jukeboxPlay" type="button" aria-label={`Play ${videos[0].title}`}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.8-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z" /></svg>
        </button>
        <div class="jukebox__caption">
          <p class="jukebox__label" id="jukeboxLabel">{videos[0].label}</p>
          <h3 class="jukebox__title" id="jukeboxTitle">{videos[0].title}</h3>
        </div>
      </div>

      <ol class="jukebox__list" aria-label="Videos">
        {videos.map((v, i) => (
          <li>
            <button
              type="button"
              class:list={['jukebox__track', { 'is-active': i === 0 }]}
              data-id={v.id}
              data-title={v.title}
              data-label={v.label}
              data-poster={posters[i].src}
              aria-label={`Play ${v.title}`}
            >
              <span class="jukebox__num">{String(i + 1).padStart(2, '0')}</span>
              <Image class="jukebox__thumb" src={v.thumb} alt="" widths={[160, 240]} sizes="96px" loading="lazy" />
              <span class="jukebox__meta">
                <span class="jukebox__track-title">{v.title}</span>
                <span class="jukebox__track-label">{v.year} · {v.label}</span>
              </span>
              <span class="jukebox__eq" aria-hidden="true"><i></i><i></i><i></i></span>
            </button>
          </li>
        ))}
        <li>
          <a class="jukebox__more" href="https://www.youtube.com/user/deancascione?sub_confirmation=1" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z" /></svg>
            Subscribe on YouTube
          </a>
        </li>
      </ol>
    </div>

    <ol class="discog">
      {releases.map((r) => (
        <li class="discog__item">
          <div class={`discog__cover${r.cover ? '' : ' discog__cover--empty'}${r.url ? ' discog__cover--linked' : ''}`}>
            {r.cover && r.url && (
              <a href={r.url} target="_blank" rel="noopener" aria-label={`Watch ${r.title} on YouTube`}>
                <Image src={r.cover} alt={`Cover art — ${r.title}`} widths={[96, 128, 192]} sizes="64px" loading="lazy" />
              </a>
            )}
            {r.cover && !r.url && (
              <Image src={r.cover} alt={`Cover art — ${r.title}`} widths={[96, 128, 192]} sizes="64px" loading="lazy" />
            )}
          </div>
          <div class="discog__year">{r.year}</div>
          <div class="discog__detail">
            <h3>
              {r.url ? (
                <a href={r.url} target="_blank" rel="noopener" class="discog__link">
                  <em>{r.title}</em>
                </a>
              ) : (
                <em>{r.title}</em>
              )}
            </h3>
            <p class="discog__note">{r.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const stage = document.getElementById('jukeboxStage');
  const poster = document.getElementById('jukeboxPoster') as HTMLImageElement | null;
  const playBtn = document.getElementById('jukeboxPlay');
  const titleEl = document.getElementById('jukeboxTitle');
  const labelEl = document.getElementById('jukeboxLabel');
  const tracks = Array.from(document.querySelectorAll<HTMLButtonElement>('.jukebox__track'));
  let current = tracks[0];

  function select(track: HTMLButtonElement) {
    current = track;
    tracks.forEach((t) => t.classList.toggle('is-active', t === track));
    if (titleEl) titleEl.textContent = track.dataset.title ?? '';
    if (labelEl) labelEl.textContent = track.dataset.label ?? '';
    playBtn?.setAttribute('aria-label', `Play ${track.dataset.title}`);
  }

  function play(track: HTMLButtonElement) {
    if (!stage) return;
    select(track);
    stage.querySelector('iframe')?.remove();
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${track.dataset.id}?autoplay=1&rel=0&modestbranding=1`;
    iframe.title = `Dean Cascione — ${track.dataset.title}`;
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    stage.appendChild(iframe);
    stage.classList.add('is-playing');
    tracks.forEach((t) => t.classList.toggle('is-playing', t === track));
    if (poster && track.dataset.poster) {
      poster.removeAttribute('srcset');
      poster.src = track.dataset.poster;
    }
  }

  playBtn?.addEventListener('click', () => play(current));
  tracks.forEach((t) => t.addEventListener('click', () => play(t)));

  // External triggers (hero button etc.): scroll the stage into view, then play.
  document.querySelectorAll<HTMLElement>('[data-play]').forEach((el) => {
    el.addEventListener('click', (e) => {
      const track = tracks.find((t) => t.dataset.id === el.dataset.play);
      if (!track || !stage) return;
      e.preventDefault();
      stage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      play(track);
    });
  });
</script>
