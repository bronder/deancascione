---
// Music — featured videos + discography timeline + free e-book
import { Image } from 'astro:assets';
import ebookCover from '~/assets/images/ebook-cover.jpg';
import dioCover from '~/assets/images/dio-tribute.jpg';
import guitarChopShopCover from '~/assets/images/guitar-chop-shop.jpg';
import neoclassicalFireCover from '~/assets/images/neoclassical-fire.jpg';
import shredCrusadeCover from '~/assets/images/shred-crusade.jpg';
import betweenTwoAnvilsCover from '~/assets/images/between-two-anvils.jpg';
import liveAtSeneCover from '~/assets/images/live-at-sene.jpg';
import rhoadsRisingCover from '~/assets/images/rhoads-rising.jpg';
import guitarSymphonyCover from '~/assets/images/guitar-symphony.jpg';
import clashOfTheTitansCover from '~/assets/images/clash-of-the-titans.jpg';
import darkLordCover from '~/assets/images/dark-lord-rises.webp';
import ytDoppelgangers from '~/assets/images/yt-doppelgangers.jpg';
import ytMissionSpace from '~/assets/images/yt-mission-space.jpg';
import ytOdysseyDarkness from '~/assets/images/yt-odyssey-of-darkness.jpg';

// Newest-first discography. `title` and `note` preserved verbatim from the
// legacy bio; `video` marks releases with an embedded YouTube link.
type Release = {
  year: string;
  title: string;
  note: string;
  cover?: ImageMetadata;
  url?: string;
};

const releases: Release[] = [
  { year: '2026', title: 'Doppelgangers', note: 'Single — collaboration with Maxxwell Carlisle.', cover: ytDoppelgangers, url: 'https://youtu.be/mkC3Xxem2Ns' },
  { year: '2024', title: 'Mission Space', note: 'Single.', cover: ytMissionSpace, url: 'https://youtu.be/VEPlyiegWJQ' },
  { year: '2024', title: 'Odyssey of Darkness', note: 'Single — collaboration with Maxxwell Carlisle.', cover: ytOdysseyDarkness, url: 'https://youtu.be/jHaTReC0d1w' },
  { year: '2023', title: 'Between Two Anvils', note: 'Single — collaboration with Maxxwell Carlisle.', cover: betweenTwoAnvilsCover },
  { year: '2020', title: 'Rhoads Rising', note: 'Single — tribute to Randy Rhoads.', cover: rhoadsRisingCover },
  {
    year: '2018',
    title: 'Clash of the Titans',
    note: 'Single — featuring American guitar virtuosos Dean Cascione, Jimi Mitchell, Mike Kerr, and Matthew Mills.',
    cover: clashOfTheTitansCover,
  },
  {
    year: '2017',
    title: 'Guitar Symphony',
    note: 'Global collaboration with over 60 guitarists including George Bellas, Rusty Cooley, and Matt Mills.',
    cover: guitarSymphonyCover,
  },
  {
    year: '2016',
    title: 'Live at the SENE Film & Music Festival',
    note: 'Limited-edition live Blu-ray performance.',
    cover: liveAtSeneCover,
  },
  {
    year: '2016',
    title: 'The Dark Lord Rises / Brothers in Shred',
    note: 'Featured on Joe Stump\'s Lion Music release.',
    cover: darkLordCover,
    url: 'https://www.metal-archives.com/albums/Joe_Stump/The_Dark_Lord_Rises/540562',
  },
  {
    year: '2015',
    title: 'Shred Crusade',
    note: 'Album — neoclassic metal with guest guitarists David Shankle, Dave Mercado, and Joe Stump.',
    cover: shredCrusadeCover,
    url: 'https://www.metal-archives.com/albums/Dean_Cascione/Shred_Crusade/533283',
  },
  {
    year: '2011',
    title: 'Neoclassical Fire',
    note: 'Album — collaboration with keyboardist Mike Troy (Yngwie Malmsteen).',
    cover: neoclassicalFireCover,
    url: 'https://www.metal-archives.com/albums/Dean_Cascione/Neoclassical_Fire/319663',
  },
  {
    year: '2010',
    title: 'Magic: A Tribute to Ronnie James Dio',
    note: 'Album — worldwide release with MANOWAR, featuring instrumental cover of "Nevermore."',
    cover: dioCover,
    url: 'https://www.discogs.com/release/4063934-Various-Magic-A-Tribute-To-Ronnie-James-Dio',
  },
  {
    year: '2008',
    title: 'Guitar Chop Shop',
    note: 'Debut album — #1 in sales on Guitar9 charts.',
    cover: guitarChopShopCover,
    url: 'https://www.metal-archives.com/albums/Dean_Cascione/Guitar_Chop_Shop/201566',
  },
];

// External download links to the existing host (per build decision: keep the
// ~120MB e-book + audio bundle on the old host, repo stays light).
const EBOOK_URL = 'https://deancascione.com/ebook/The%20Neoclassic%20approach%20to%20Shred%20Guitar.pdf';
const AUDIO_URL = 'https://deancascione.com/ebook/Audio_files.rar';
---

<section class="section section--elevated" id="music">
  <div class="container">
    <div class="section-head">
      <span class="section-eyebrow">Music</span>
      <h2 class="section-title">Discography &amp; Videos</h2>
      <p class="section-subtitle">
        Two decades of neoclassical shred — solo albums, global collaborations,
        and tribute work alongside the legends of metal.
      </p>
    </div>

    <div class="music__videos">
      <article class="video-card">
        <div class="video-card__media">
          <iframe
            src="https://www.youtube-nocookie.com/embed/VEPlyiegWJQ"
            title="Dean Cascione — Mission Space"
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <div class="video-card__body">
          <p class="video-card__label">Original</p>
          <h3 class="video-card__title">Mission Space</h3>
        </div>
      </article>

      <article class="video-card">
        <div class="video-card__media">
          <iframe
            src="https://www.youtube-nocookie.com/embed/mkC3Xxem2Ns"
            title="Dean Cascione & Maxxwell Carlisle — Doppelgangers"
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <div class="video-card__body">
          <p class="video-card__label">Latest Release · feat. Maxxwell Carlisle</p>
          <h3 class="video-card__title">Doppelgangers</h3>
        </div>
      </article>
    </div>

    <ol class="discog">
      {releases.map((r) => (
        <li class="discog__item">
          <div class={`discog__cover${r.cover ? '' : ' discog__cover--empty'}${r.url ? ' discog__cover--linked' : ''}`}>
            {r.cover && r.url && (
              <a href={r.url} target="_blank" rel="noopener" aria-label={`Watch ${r.title} on YouTube`}>
                <Image src={r.cover} alt={`Cover art — ${r.title}`} widths={[96, 128, 192]} sizes="64px" loading="lazy" />
              </a>
            )}
            {r.cover && !r.url && (
              <Image src={r.cover} alt={`Cover art — ${r.title}`} widths={[96, 128, 192]} sizes="64px" loading="lazy" />
            )}
          </div>
          <div class="discog__year">{r.year}</div>
          <div class="discog__detail">
            <h3>
              {r.url ? (
                <a href={r.url} target="_blank" rel="noopener" class="discog__link">
                  <em>{r.title}</em>
                </a>
              ) : (
                <em>{r.title}</em>
              )}
            </h3>
            <p class="discog__note">{r.note}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="ebook">
      <figure class="ebook__cover">
        <Image
          src={ebookCover}
          alt="The Neoclassic Approach to Shred Guitar — book cover"
          widths={[200, 300, 400]}
          sizes="200px"
          loading="lazy"
        />
      </figure>
      <div>
        <p class="section-eyebrow" style="margin-bottom: 0.75rem;">Free Download</p>
        <h3 class="ebook__title">The Neoclassic Approach to Shred Guitar</h3>
        <p class="ebook__desc">
          Co-authored with Sebastian Salinas (2018), this 100+ page instructional
          book is packed with tips and lessons guaranteed to increase your guitar
          vocabulary. Transcribed in English and Spanish — available now as a
          free download.
        </p>
        <div class="ebook__downloads">
          <a href={EBOOK_URL} class="btn btn--primary" target="_blank" rel="noopener">
            E-Book (PDF)
          </a>
          <a href={AUDIO_URL} class="btn btn--ghost" target="_blank" rel="noopener">
            Audio Files
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
