---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Nav from '~/components/Nav.astro';
import Hero from '~/components/Hero.astro';
import Legends from '~/components/Legends.astro';
import About from '~/components/About.astro';
import Press from '~/components/Press.astro';
import Music from '~/components/Music.astro';
import LeadMagnet from '~/components/LeadMagnet.astro';
import Lessons from '~/components/Lessons.astro';
import Endorsements from '~/components/Endorsements.astro';
import Performances from '~/components/Performances.astro';
import Gallery from '~/components/Gallery.astro';
import Contact from '~/components/Contact.astro';
import Footer from '~/components/Footer.astro';
import StickyCta from '~/components/StickyCta.astro';
---

<BaseLayout>
  <Nav active="home" />
  <main id="main">
    <Hero />
    <Legends />
    <About />
    <Press />
    <Music />
    <LeadMagnet />
    <Lessons />
    <Endorsements />
    <Performances />
    <Gallery />
    <Contact />
  </main>
  <Footer />
  <StickyCta />
</BaseLayout>
